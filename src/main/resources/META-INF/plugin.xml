<idea-plugin>
    <id>io.github.gudwns1812.jiratask</id>
    <name>Jira Task</name>
    <vendor url="https://github.com/gudwns1812/jira-task-plugin">gudwns1812</vendor>

    <description><![CDATA[
        Fits the RULE.md based Jira workflow into the IDE's Git flow.
        Provides a first-run setup wizard, a picker for the tasks in the current sprint,
        automatic Jira issue keys in Git commit messages with a pre-commit check,
        and a search that reads and edits an issue without leaving the IDE.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Jira Task" displayType="BALLOON"/>
        <!-- 커밋 창이 열릴 때의 기본 메시지. 모달 다이얼로그와 커밋 툴 윈도우가 함께 쓰는 경로다. -->
        <vcs.commitMessageProvider
            implementation="io.github.gudwns1812.jiratask.ui.commit.JiraTaskCommitMessageProvider"/>
        <!-- 커밋 직전에 이슈 키를 한 번 더 보정하는 안전망. -->
        <checkinHandlerFactory implementation="io.github.gudwns1812.jiratask.ui.commit.JiraTaskCheckinHandlerFactory"/>
        <statusBarWidgetFactory id="JiraTask.CurrentTask"
                                implementation="io.github.gudwns1812.jiratask.ui.task.CurrentTaskWidgetFactory"
                                order="last"/>
        <toolWindow id="Jira Task"
                    anchor="right"
                    icon="AllIcons.Vcs.Branch"
                    factoryClass="io.github.gudwns1812.jiratask.ui.toolwindow.JiraTaskToolWindowFactory"/>
        <postStartupActivity implementation="io.github.gudwns1812.jiratask.ui.JiraTaskSetupStartupActivity"/>
        <applicationConfigurable id="io.github.gudwns1812.jiratask.settings"
                                 parentId="tools"
                                 instance="io.github.gudwns1812.jiratask.ui.JiraTaskConfigurable"
                                 displayName="Jira Task"/>
    </extensions>

    <actions>
        <group id="JiraTask.Menu" text="Jira Task" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <action id="JiraTask.StartTask"
                    class="io.github.gudwns1812.jiratask.ui.task.StartTaskAction"
                    text="Start Jira Task"
                    description="커밋에 사용할 현재 Jira 작업 번호를 저장합니다"
                    icon="AllIcons.Actions.Execute"/>
            <action id="JiraTask.Commit"
                    class="io.github.gudwns1812.jiratask.ui.commit.CommitWithJiraTaskAction"
                    text="Commit with Jira Task"
                    description="현재 작업 번호로 이슈 키를 붙여 스테이지된 변경 사항을 커밋합니다"
                    icon="AllIcons.Actions.Commit"/>
            <action id="JiraTask.CreateMergeRequest"
                    class="io.github.gudwns1812.jiratask.ui.mr.CreateMergeRequestAction"
                    text="Create Merge Request"
                    description="현재 브랜치의 커밋에서 Jira 작업 키를 모아 GitLab MR을 만듭니다"
                    icon="AllIcons.Vcs.Merge"/>
            <action id="JiraTask.Search"
                    class="io.github.gudwns1812.jiratask.ui.search.JiraSearchAction"
                    text="Search Jira Issues"
                    description="이슈를 찾아 제목과 설명을 확인하고 고칩니다"
                    icon="AllIcons.Actions.Search"/>
            <separator/>
            <action id="JiraTask.OpenSettings"
                    class="io.github.gudwns1812.jiratask.ui.OpenJiraTaskSettingsAction"
                    text="Jira Task Settings"
                    description="Jira 주소·프로젝트 키와 GitLab 주소·토큰을 설정합니다"
                    icon="AllIcons.General.GearPlain"/>
            <action id="JiraTask.RunSetupWizard"
                    class="io.github.gudwns1812.jiratask.ui.RunSetupWizardAction"
                    text="Run Setup Wizard"
                    description="Jira 연결과 프로젝트 기본값을 마법사로 설정합니다"
                    icon="AllIcons.General.Settings"/>
        </group>

        <!--
            IDE 커밋 창의 메시지 칸 옆 툴바. 커밋은 대부분 여기서 하므로 초안 버튼도 여기 둔다.
            Jira Task 메뉴에는 넣지 않는다 — 채울 메시지 칸이 없는 자리에서는 할 일이 없다.
        -->
        <action id="JiraTask.DraftCommitMessage"
                class="io.github.gudwns1812.jiratask.ui.commit.DraftCommitMessageAction"
                text="AI로 커밋 메시지 쓰기"
                description="커밋할 변경을 보고 Claude Code가 커밋 메시지 초안을 씁니다"
                icon="AllIcons.Actions.IntentionBulb">
            <add-to-group group-id="Vcs.MessageActionGroup" anchor="first"/>
        </action>

        <!-- 툴 윈도우 상단 아이콘 툴바. 메뉴와 같은 액션을 참조해 동작이 갈라지지 않게 한다. -->
        <group id="JiraTask.ToolWindowToolbar">
            <reference id="JiraTask.StartTask"/>
            <reference id="JiraTask.Commit"/>
            <reference id="JiraTask.CreateMergeRequest"/>
            <reference id="JiraTask.Search"/>
            <separator/>
            <reference id="JiraTask.OpenSettings"/>
            <reference id="JiraTask.RunSetupWizard"/>
        </group>
    </actions>
</idea-plugin>
