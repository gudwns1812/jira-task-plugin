<idea-plugin>
    <id>io.github.gudwns1812.jiratask</id>
    <name>Jira Task</name>
    <vendor url="https://github.com/gudwns1812/task-jira-cli">gudwns1812</vendor>

    <description><![CDATA[Jira Task helps create Jira issues from the IDE. This is an early skeleton build; issue creation features are still in progress.]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Jira Task" displayType="BALLOON"/>
        <postStartupActivity implementation="io.github.gudwns1812.jiratask.ui.JiraTaskSetupStartupActivity"/>
        <applicationConfigurable id="io.github.gudwns1812.jiratask.settings"
                                 parentId="tools"
                                 instance="io.github.gudwns1812.jiratask.ui.JiraTaskConfigurable"
                                 displayName="Jira Task"/>
    </extensions>

    <actions>
        <action id="JiraTask.RunSetupWizard"
                class="io.github.gudwns1812.jiratask.ui.RunSetupWizardAction"
                text="Jira Task 설정 마법사"
                description="Jira 연결과 프로젝트 기본값을 마법사로 설정합니다">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="JiraTask.CreateIssue"
                class="io.github.gudwns1812.jiratask.CreateJiraIssueAction"
                text="Create Jira Issue"
                description="Jira 이슈 생성 (준비 중)">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
